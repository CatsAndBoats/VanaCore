+/* VanaCore: Windower's Lua lets a literal (nil, true, false, ..., a number, string, table
+** constructor or function) go on like a name does, with suffixes: 'x':upper(), {a, b}[i],
+** function() ... end(), ...:lower(), 127'text'. All of these are syntax errors in standard Lua.
+** A '(' only counts on the literal's own line, as a call's does anywhere.
+*/
+static int literal_suffix(LexState *ls)
+{
+  return ls->tok == '.' || ls->tok == '[' || ls->tok == ':' || ls->tok == TK_string ||
+	 ls->tok == '{' || (ls->tok == '(' && ls->linenumber == ls->lastline);
+}
+
+static void expr_literal_suffixes(LexState *ls, ExpDesc *v, int eflags)
+{
+  if (literal_suffix(ls))
+    expr_primary_end(ls, v, expr_suffixes(ls, v, eflags));
+}
